[Unit]
Description=Mihari
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/lib/mihari/mihari daemon
Restart=always
RestartSec=120
Environment=MIHARI_CONTROL_ENDPOINT=/var/lib/mihari/control.sock
Environment=MIHARI_CONTROL_CREDENTIAL=/var/lib/mihari/control.token
Environment=MIHARI_INSTALL_ROOT=/usr/local/lib/mihari

[Install]
WantedBy=multi-user.target
