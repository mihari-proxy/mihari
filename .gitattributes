# Normalize line endings. Default everything to LF in the repo and on checkout
# so shell scripts and Go files stay LF regardless of the host OS.
* text=auto eol=lf

# PowerShell is a Windows citizen; keep CRLF for it.
*.ps1 text eol=crlf

# Shell scripts must be LF or they break under bash.
*.sh text eol=lf

# Golden render fixtures are byte-compared in tests; the comparison normalizes
# to LF, so checkout must always produce LF even under core.autocrlf=true.
*.golden text eol=lf

# Treat binaries as binary (no EOL munging) if any are ever added.
# NOTE: `binary` only unsets `text`; `eol` must be explicitly unset too,
# otherwise `* eol=lf` above forces EOL conversion on binaries and corrupts them.
*.gz binary -eol
*.zip binary -eol
*.png binary -eol
*.exe binary -eol
